# Xaubot environment - copy to .env on your VPS.
# Keep the bot token private. Never commit .env to GitHub.
# Discord Developer Portal > Applications > your app > Bot > Token
DISCORD_BOT_TOKEN=
# Discord channel: enable Developer Mode, then Copy Channel ID.
DISCORD_CHANNEL_ID=
# The single Discord server allowed to receive bot slash commands.
DISCORD_GUILD_ID=

# Optional AI advisory commentary via OpenAI Responses API.
OPENAI_API_KEY=
OPENAI_MODEL=

# Opt-in: 0 until you have verified bot permissions and market data.
# Once enabled, only fresh GWS_PRIMARY research candidates are posted.
XAUBOT_SEND_DISCORD=0

# Optional research-only forward journal Docker profile is OFF by default.
# Never set to 1 until broker server UTC offset is independently verified.
# This does not enable broker order execution, AI, or Discord alerts.
XAUBOT_BROKER_OFFSET_VERIFIED=0
# Provisional broker-offset hypothesis (+120 minutes); operator must verify.
XAUBOT_BROKER_UTC_OFFSET_MINUTES=120
